    "main": "src/index.js",
    "license": "LGPL-2.1-or-later",
    "repository": {
        "type": "git",
        "url": "https://github.com/digital-blueprint/activities.git",
        "directory": "packages/prepare-media-transparency-report"
    },
    "devDependencies": {
        "@dbp-toolkit/dev-utils": "^0.1.2",
        "@rollup/plugin-replace": "^6.0.0",
        "@rollup/plugin-url": "^8.0.0",
        "@web/test-runner": "^1.0.0",
        "@web/test-runner-playwright": "^1.0.0",
        "chai": "^6.0.0",
        "i18next-cli": "^1.9.0",
        "mocha": "^12.0.0",
        "oxlint": "^1.81.0",
        "oxlint-tsgolint": "^7.0.2001",
        "playwright": "^1.34.0",
        "playwright-core": "^1.21.0",
        "prettier": "^3.0.0",
        "rolldown": "^1.0.0-rc.4",
        "rollup-plugin-serve": "^3.0.0",
        "typescript": "^7.0.0"
    },
    "dependencies": {
        "@dbp-toolkit/common": "^0.3.0",
        "@webcomponents/scoped-custom-element-registry": "^0.0.10",
        "lit": "^3.0.0",
        "papaparse": "^5.5.3"
    },
    "scripts": {
        "clean": "rm dist/*",
        "fix": "npm run oxlint:fix && npm run prettier:fix && npm run i18next:fix",
        "check": "npm run oxlint && npm run prettier && npm run i18next",
        "oxlint:fix": "oxlint . --fix",
        "oxlint": "oxlint .",
        "prettier:fix": "prettier \"**/*.{js,json,ts,md,yaml,yml}\" --write",
        "prettier": "prettier \"**/*.{js,json,ts,md,yaml,yml}\" --check",
        "i18next:fix": "i18next-cli extract",
        "i18next": "i18next-cli extract --ci --dry-run",
        "build": "npm run build-local",
        "build-local": "rolldown -c rolldown.config.js",
        "build-dev": "rolldown -c rolldown.config.js --environment BUILD:development",
        "build-prod": "rolldown -c rolldown.config.js --environment BUILD:production",
        "build-demo": "rolldown -c rolldown.config.js --environment BUILD:demo",
        "build-test": "rolldown -c rolldown.config.js --environment BUILD:test",
        "watch": "npm run watch-local",
        "watch-local": "rolldown -c rolldown.config.js --watch",
        "watch-dev": "rolldown -c rolldown.config.js --watch --environment BUILD:development",
        "test": "npm run build-test && web-test-runner",
        "tsc": "tsc -p jsconfig.json"
    }
}
