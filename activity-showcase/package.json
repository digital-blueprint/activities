{
    "name": "dbp-activity-showcase",
    "version": "0.2.0",
    "type": "module",
    "main": "src/activity-showcase.js",
    "license": "LGPL-2.1-or-later",
    "private": true,
    "dbp": {
        "urls": [
            {
                "srcPackage": "highlight.js",
                "src": "**/*.css"
            }
        ]
    },
    "devDependencies": {
        "@web/test-runner": "^1.0.0",
        "@web/test-runner-playwright": "^1.0.0",
        "chai": "^6.0.0",
        "i18next-cli": "^1.9.0",
        "marked": "^18.0.0",
        "marked-highlight": "^2.2.3",
        "mocha": "^12.0.0",
        "oxlint": "^1.81.0",
        "oxlint-tsgolint": "^7.0.2001",
        "prettier": "^3.0.0",
        "rolldown": "^1.0.0-rc.5",
        "rollup-plugin-emit-ejs": "^3.1.0",
        "rollup-plugin-license": "^3.0.0",
        "rollup-plugin-serve": "^3.0.0",
        "typescript": "^7.0.0"
    },
    "dependencies": {
        "@dbp-toolkit/app-shell": "^0.3.0",
        "@dbp-toolkit/auth": "^0.3.0",
        "@dbp-toolkit/common": "^0.3.0",
        "@dbp-toolkit/language-select": "^0.3.0",
        "@dbp-toolkit/tabulator-table": "^0.1.0",
        "@dbp-topics/clipboard": "^0.2.0",
        "@dbp-topics/group-manage": "^0.1.0",
        "@dbp-topics/portfolio": "^0.1.0",
        "@dbp-topics/prepare-media-transparency-report": "^0.1.0",
        "@fontsource/nunito-sans": "^5.0.0",
        "@tugraz/font-source-sans-pro": "^0.2.4",
        "@tugraz/web-components": "^0.3.6",
        "@webcomponents/scoped-custom-element-registry": "^0.0.10",
        "highlight.js": "^11.0.0",
        "i18next": "^26.0.0",
        "jsrsasign": "^11.0.0",
        "jsrsasign-util": "^1.0.5",
        "jws": "^4.0.0",
        "lit": "^3.0.0",
        "select2": "^4.1.0"
    },
    "scripts": {
        "build": "rolldown -c rolldown.config.js",
        "fix": "npm run oxlint:fix && npm run prettier:fix && npm run i18next:fix",
        "check": "npm run oxlint && npm run prettier && npm run i18next",
        "oxlint:fix": "oxlint . --fix",
        "oxlint": "oxlint .",
        "prettier:fix": "prettier \"**/*.{js,json,ts,md,yaml,yml}\" --write",
        "prettier": "prettier \"**/*.{js,json,ts,md,yaml,yml}\" --check",
        "i18next:fix": "i18next-cli extract",
        "i18next": "i18next-cli extract --ci --dry-run",
        "watch": "rolldown -c rolldown.config.js --watch",
        "watch-local": "npm run watch",
        "watch-full": "rolldown -c rolldown.config.js --watch --environment FORCE_FULL",
        "watch-bs": "rolldown -c rolldown.config.js --watch --environment APP_ENV:bs",
        "build:test": "rolldown -c rolldown.config.js --environment APP_ENV:test",
        "test": "npm run build:test && web-test-runner",
        "tsc": "tsc -p jsconfig.json"
    }
}
